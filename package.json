{
  "name": "owlbear-compcon-activemode",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "node --max-old-space-size=8192 node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "build-nocheck": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mongo": "node --env-file=.env scripts/test-mongo.mjs",
    "lcps": "node scripts/fetch-official-lcps.mjs",
    "lcps:update": "node scripts/fetch-official-lcps.mjs --force",
    "i18n:sync": "node scripts/sync-pt-translations.mjs",
    "i18n:manual": "node scripts/apply-manual-translations.mjs",
    "i18n:llp": "node scripts/build-llp.mjs",
    "i18n:lcps": "node scripts/inject-llp-into-lcps.mjs",
    "i18n:check": "node scripts/check-lcp-translations.mjs",
    "i18n:verify": "node scripts/check-lcp-translations.mjs --check=95 && node scripts/inject-llp-into-lcps.mjs --check"
  },
  "dependencies": {
    "@kyvg/vue3-notification": "3.4.2",
    "@massif/lancer-data": "^4.0.11",
    "@mdi/font": "7.4.47",
    "@owlbear-rodeo/sdk": "^2.3.0",
    "@sentry/vue": "^10.75.0",
    "@vueup/vue-quill": "^1.2.0",
    "aws-amplify": "6.16.2",
    "chart.js": "4.5.1",
    "chartjs-plugin-annotation": "3.1.0",
    "chartjs-plugin-datalabels": "2.2.0",
    "dompurify": "^3.3.1",
    "expr-eval": "^2.0.2",
    "jszip": "3.10.1",
    "localforage": "1.10.0",
    "lodash-es": "^4.17.23",
    "marked": "^15.0.12",
    "mongodb": "^6.21.0",
    "pinia": "3.0.4",
    "quill": "^2.0.2",
    "semver": "7.7.4",
    "sortablejs": "^1.15.7",
    "sortablejs-vue3": "^1.3.0",
    "typeit": "^8.8.7",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "3.5.29",
    "vue-advanced-cropper": "2.8.9",
    "vue-chartjs": "5.3.3",
    "vue-html-secure": "^1.0.10",
    "vue-i18n": "^11",
    "vue-router": "4.6.4",
    "vuetify": "^3.12.1",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@pinia/testing": "1.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.19.11",
    "@types/selfsigned": "^2.0.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.1",
    "sass": "^1.97.3",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
